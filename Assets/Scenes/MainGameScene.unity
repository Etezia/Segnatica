      m_Calls: []
  m_text: 'E: interract

    Tab: open inventory

    1-8: select hotbar item

    H:
    deselect all hotbar items

    Shift: run

    C: slow down

    Space: jump

    LMB
    (with weapon/tool): attack/use

    LMB (in inventory): use

    RMB (in inventory):
    drop item

    T: spawn foundation (uses wooden planks)

    Y: spawn wall

    U:
    spawn floor

    RMB (with construction): cancel placement

    Scroll (with
    construction): rotate construction'
